rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========= HELPER FUNCTIONS =========
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "suqcleaning2@gmail.com" ||
        request.auth.token.email == "mqaisar11550@gmail.com"
      );
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // ========= PUBLIC USER PANEL DATA =========

    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /app_content/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isLoggedIn() && request.auth.uid == resource.data.userId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Login lockout counters (checked before and after sign-in)
    match /login_attempts/{emailId} {
      allow read, create, update: if true;
    }

    // ========= USER AUTHENTICATED PANEL DATA =========

    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isLoggedIn() && (resource.data.userId == request.auth.uid || isAdmin() || resource.data.listingId != null);
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isLoggedIn() && request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /wishlists/{wishlistId} {
      allow read: if isLoggedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isLoggedIn() && request.auth.uid == resource.data.userId);
    }

    match /lister_applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ========= ADMIN PANEL EXCLUSIVE DATA =========

    match /notifications/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isLoggedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
